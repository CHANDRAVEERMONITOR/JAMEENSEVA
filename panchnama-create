<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JameenSeva - Panchnama Pro Final</title>
    
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <style>
        body { font-family: 'Arial', sans-serif; background-color: #f4f7f6; padding: 20px; color: #333; }
        .section-box { background: white; padding: 25px; border-radius: 12px; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid #ddd; }
        h3 { color: #1a5928; border-left: 6px solid #0a7f3f; padding-left: 12px; margin-bottom: 20px; }
        h4 { color: #0a7f3f; border-bottom: 1px solid #eee; padding-bottom: 5px; margin-top: 0; }
        .input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 10px; }
        input, select { padding: 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; width: 100%; box-sizing: border-box; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #aaa; padding: 10px; text-align: left; }
        th { background: #f8f9fa; font-size: 13px; }
        .total-box { background: #e8f5e9; font-weight: bold; padding: 10px; border: 1px solid #0a7f3f; margin-top: -1px; text-align: right; }
        .btn { padding: 12px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; transition: 0.3s; }
        .btn-add { background: #0a7f3f; color: white; }
        .btn-remove { background: #d32f2f; color: white; font-size: 12px; padding: 5px 10px; }
        .fariq-card { border: 1px solid #ddd; padding: 15px; margin-bottom: 15px; border-radius: 8px; background: #fff; }
        .son-input { margin-top: 5px; width: 90% !important; margin-left: 25px; display: block; }
    </style>
</head>
<body>

    <h2 style="text-align: center; color: #0a7f3f;">⚖️ JameenSeva: Professional Panchnama Generator</h2>

    <div id="mainForm">
        <div class="section-box">
            <h3>👥 फरीकेन का विवरण (Step 1)</h3>
            <div id="fariqContainer"></div>
            <button type="button" class="btn btn-add" onclick="addFariqRow()">+ नया फरीक जोड़ें</button>
        </div>

        <div class="section-box">
            <h3>📄 कुल पैतृक सम्पति (Step 2)</h3>
            <table>
                <thead>
                    <tr><th>मौजा</th><th>खाता</th><th>खेसरा</th><th>रकवा (नंबर)</th><th>Action</th></tr>
                </thead>
                <tbody id="landBody"></tbody>
            </table>
            <div class="total-box">कुल रकवा: <span id="total_land_val">0</span></div>
            <button type="button" class="btn btn-add" onclick="addLandRow()" style="margin-top:10px;">+ नया प्लॉट जोड़ें</button>
        </div>

        <div class="section-box">
            <h3>📐 बँटवारा शेड्यूल (Step 3)</h3>
            <div id="allocationContainer"></div>
            <button type="button" class="btn btn-add" onclick="addAllocationBox()">+ नया शेड्यूल जोड़ें</button>
        </div>

        <div class="section-box">
            <h3>🌳 वंशावली वृक्ष (Step 4)</h3>
            <input id="ancestor_name" placeholder="मुख्य पूर्वज (उदा: स्व० रामलखन यादव)" style="margin-bottom:15px; font-weight: bold; border: 2px solid #0a7f3f;">
            <div id="treeMemberContainer"></div>
            <button type="button" class="btn btn-add" onclick="addTreeMember()">+ वंशज जोड़ें</button>
        </div>

        <div style="text-align: center; margin: 50px;">
            <button id="finalBtn" class="btn btn-add" style="background: #2c3e50; padding: 20px 60px; font-size: 20px;" onclick="generateFinalPDF()">💾 DOWNLOAD FINAL PDF</button>
        </div>
    </div>

<script>
    // --- SUPABASE CONFIG ---
    const _supabaseUrl = 'https://nkhthnkngt410q9xfqis.supabase.co';
    const _supabaseKey = 'sb_publishable_9w-thNkNGT410q9-xfqISQ_sH2Uzmv5';
    const _supabase = supabase.createClient(_supabaseUrl, _supabaseKey);

    // --- FORM ACTIONS ---
    function addFariqRow() {
        const div = document.createElement('div');
        div.className = 'fariq-card';
        div.innerHTML = `<div class="input-grid"><input placeholder="नाम" class="f-name"><input placeholder="पिता/पति" class="f-guardian"><input placeholder="आधार" class="f-aadhar"><input placeholder="जाति" class="f-caste"></div><button type="button" class="btn btn-remove" onclick="this.parentElement.remove()">❌</button>`;
        document.getElementById('fariqContainer').appendChild(div);
    }

    function addLandRow() {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><input></td><td><input></td><td><input></td><td><input type="number" class="calc-rakwa" oninput="updateTotal()"></td><td><button type="button" class="btn btn-remove" onclick="this.parentElement.parentElement.remove(); updateTotal()">✕</button></td>`;
        document.getElementById('landBody').appendChild(tr);
    }

    function updateTotal() {
        let t = 0;
        document.querySelectorAll('#landBody .calc-rakwa').forEach(i => t += (parseFloat(i.value) || 0));
        document.getElementById('total_land_val').innerText = t.toFixed(3);
    }

    function addAllocationBox() {
        const id = Date.now();
        const div = document.createElement('div');
        div.className = 'fariq-card';
        div.id = 'alloc_'+id;
        div.innerHTML = `<h4>अनुसूची (Schedule)</h4><input placeholder="हिस्सेदार का नाम" class="h-name" style="font-weight:bold; margin-bottom:10px;"><table><thead><tr><th>खाता</th><th>खेसरा</th><th>रकवा</th><th>चौहद्दी</th></tr></thead><tbody class="alloc-body"></tbody></table><div class="total-box">कुल हिस्सा: <span class="sub-total">0</span></div><button type="button" class="btn btn-add" style="background:#666; font-size:11px;" onclick="addAllocRow(this, '${id}')">+ प्लॉट</button>`;
        document.getElementById('allocationContainer').appendChild(div);
        addAllocRow(div.querySelector('.btn-add'), id);
    }

    function addAllocRow(btn, id) {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><input></td><td><input></td><td><input type="number" class="sub-calc" oninput="updateSub('${id}')"></td><td><input placeholder="N-S-E-W"></td>`;
        btn.parentElement.querySelector('.alloc-body').appendChild(tr);
    }

    function updateSub(id) {
        let t = 0;
        document.querySelectorAll('#alloc_'+id+' .sub-calc').forEach(i => t += (parseFloat(i.value) || 0));
        document.querySelector('#alloc_'+id+' .sub-total').innerText = t.toFixed(3);
    }

    function addTreeMember() {
        const div = document.createElement('div');
        div.className = 'fariq-card';
        div.innerHTML = `<div style="display:flex; gap:10px;"><select class="v-status" onchange="toggleSons(this)"><option value="स्व०">स्व०</option><option value="✅">✅ जीवित</option></select><input placeholder="नाम" class="v-name"></div><div class="son-sec" style="margin-top:10px;"><div class="s-list"></div><button type="button" onclick="addSon(this)">+ पुत्र जोड़ें</button></div>`;
        document.getElementById('treeMemberContainer').appendChild(div);
    }

    function addSon(btn) {
        const inp = document.createElement('input');
        inp.placeholder = "पुत्र का नाम";
        inp.className = "son-input";
        btn.previousElementSibling.appendChild(inp);
    }

    function toggleSons(sel) {
        sel.parentElement.nextElementSibling.style.display = (sel.value==='✅'?'none':'block');
    }

    // --- PDF ENGINE ---
    async function generateFinalPDF() {
        const btn = document.getElementById('finalBtn');
        btn.innerText = "Processing...";
        btn.disabled = true;

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        const anc = document.getElementById('ancestor_name').value || "__________";
        const tRakwa = document.getElementById('total_land_val').innerText;

        // PAGE 1: STAMP & INTRO
        doc.setFontSize(20);
        doc.text("सहमति पंचनामा बँटवारा", 105, 110, { align: 'center' });
        
        doc.setFontSize(12);
        let intro = `हम फरीकेन आपस में सगे सम्बन्धी हैं। हमारे पूर्वज स्व० ${anc} की कुल सम्पति (रकवा ${tRakwa} डिसमिल) को हम सभी आपसी सहमति से निम्नलिखित विवरण के अनुसार आपस में बाँट रहे हैं।`;
        doc.text(doc.splitTextToSize(intro, 170), 20, 125);

        // PAGE 1 TABLE
        let y = 145;
        doc.text("1. कुल सम्पति विवरण:", 20, 140);
        doc.rect(20, y, 170, 8); doc.text("मौजा", 22, y+6); doc.text("खाता", 60, y+6); doc.text("खेसरा", 100, y+6); doc.text("रकवा", 150, y+6);
        document.querySelectorAll('#landBody tr').forEach(tr => {
            y+=8; doc.rect(20, y, 170, 8);
            doc.text(tr.cells[0].querySelector('input').value, 22, y+6);
            doc.text(tr.cells[1].querySelector('input').value, 60, y+6);
            doc.text(tr.cells[2].querySelector('input').value, 100, y+6);
            doc.text(tr.cells[3].querySelector('input').value, 150, y+6);
        });
        addSigns(doc);

        // SCHEDULE PAGES (Auto Page Break)
        document.querySelectorAll('[id^="alloc_"]').forEach((box, i) => {
            doc.addPage();
            doc.setFontSize(14);
            doc.text(`अनुसूची (Schedule) - ${i+1}`, 105, 20, { align: 'center' });
            doc.setFontSize(11);
            doc.text(`आवंटित फरीक: ${box.querySelector('.h-name').value}`, 20, 35);
            
            let sy = 45;
            doc.rect(20, sy, 170, 8); doc.text("खाता", 22, sy+6); doc.text("खेसरा", 50, sy+6); doc.text("रकवा", 80, sy+6); doc.text("चौहद्दी", 110, sy+6);
            box.querySelectorAll('.alloc-body tr').forEach(tr => {
                sy+=10; doc.rect(20, sy, 170, 10);
                doc.text(tr.cells[0].querySelector('input').value, 22, sy+6);
                doc.text(tr.cells[1].querySelector('input').value, 50, sy+6);
                doc.text(tr.cells[2].querySelector('input').value, 80, sy+6);
                doc.text(tr.cells[3].querySelector('input').value, 110, sy+6);
            });
            doc.text(`कुल हिस्सा: ${box.querySelector('.sub-total').innerText} डिसमिल`, 140, sy+20);
            addSigns(doc);
        });

        // FINAL PAGE: VANSHAVALI
        doc.addPage();
        doc.text("🌳 वंशावली वृक्ष", 105, 20, { align: 'center' });
        let vy = 40;
        document.querySelectorAll('#treeMemberContainer .fariq-card').forEach(c => {
            doc.text(`${c.querySelector('.v-status').value} ${c.querySelector('.v-name').value}`, 25, vy);
            vy+=8;
            c.querySelectorAll('.son-input').forEach(s => {
                doc.text(`   |_ पुत्र: ${s.value}`, 30, vy); vy+=8;
            });
            vy+=5;
        });
        addSigns(doc);

        doc.save(`Panchnama_${anc}.pdf`);
        btn.innerText = "💾 DOWNLOAD FINAL PDF";
        btn.disabled = false;
        
        // Supabase Save
        try { _supabase.from('panchnama_pro').insert([{ full_data: { ancestor: anc, total: tRakwa } }]); } catch(e){}
    }

    function addSigns(doc) {
        const h = doc.internal.pageSize.height;
        doc.setFontSize(10);
        doc.line(20, h-30, 190, h-30);
        doc.text("हस्ताक्षर सरपंच (Left)", 20, h-20);
        doc.text("हस्ताक्षर फरीकेन / गवाह (Right)", 140, h-20);
        doc.text("Page " + doc.internal.getNumberOfPages(), 105, h-10, {align: 'center'});
    }

    window.onload = () => { addFariqRow(); addLandRow(); addAllocationBox(); addTreeMember(); };
</script>
</body>
</html>
